# Backend selection (start.cmd sets these for you):
#   VITE_MOCK=1  -> built-in mock backend with demo data
#   VITE_MOCK=0  -> real overseer (via the Vite proxy to localhost:8080, or VITE_OVERSEER_URL)
#   unset        -> mock, unless VITE_OVERSEER_URL is set
# VITE_MOCK=1
# VITE_OVERSEER_URL=http://localhost:8080
